# Copie para .env (nunca commitar o .env).
DEBUG=true
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=sqlite:///db.sqlite3
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Lista separada por virgula; a primeira cifra, as demais so decifram (rotacao).
FIELD_ENCRYPTION_KEYS=
STAFF_NOTIFY_EMAIL=
WHATSAPP_ENABLED=false
DEFAULT_FROM_EMAIL=CT Novos Talentos <nao-responda@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

# Reverse proxies in front of the app that append to X-Forwarded-For (throttle IP).
# 0 = ignore the header (use socket address only). Set 1 behind a single proxy.
TRUSTED_PROXY_COUNT=0

# HSTS (so em producao). Padrao conservador: 3600 (1 hora), sem subdominios/preload.
# Suba aos poucos (ver docs/DEPLOY.md): 86400 -> 2592000 -> 31536000.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
